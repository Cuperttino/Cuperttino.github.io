# Copia este archivo como .env y ajusta lo que necesites. Ningún valor es obligatorio.

# Puerto y dirección del servidor
PORT=4173
HOST=127.0.0.1

# URL pública (solo para sitemap.xml y enlaces canónicos cuando se publique)
# SITE_URL=https://tu-dominio.example

# Minutos entre actualizaciones automáticas de noticias
NEWS_TTL_MINUTES=15

# --- Opinión ampliada con IA en el comparador (opcional) ---
# La clave se usa solo en el servidor; nunca se envía al navegador.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5

# Ponlo a "production" al publicar con HTTPS (activa cookies Secure)
# NODE_ENV=production
